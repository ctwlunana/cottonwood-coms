# --- Required ---
DATABASE_URL=postgres://coms:coms_dev@localhost:5432/coms
# Public base URL (used in reset links / notifications)
APP_URL=http://localhost:3000
# Set to "true" behind HTTPS so session cookies are Secure
COOKIE_SECURE=false
# Directory for uploaded files (must NOT be inside /public)
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_MB=10

# --- Optional: Email (SMTP). Leave empty => email channel is "skipped" and logged ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Optional: WhatsApp Business Cloud API. Leave empty => channel disabled ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Tests only ---
TEST_DATABASE_URL=postgres://coms:coms_dev@localhost:5432/coms_test
