{
  "name": "coms",
  "version": "0.1.0",
  "private": true,
  "description": "Cottonwood Operations Management System",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:demo": "tsx scripts/seed.ts --demo",
    "admin:create": "tsx scripts/create-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "cron": "tsx scripts/cron.ts",
    "test:e2e": "node tests/e2e/roles.e2e.mjs && node tests/e2e/lifecycle.e2e.mjs",
    "backup": "echo \"Gunakan menu Pengaturan → Backup di aplikasi (atau scripts/backup.sh untuk server PostgreSQL sendiri)\"",
    "backup:restore": "tsx scripts/restore.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev --port 8787 --test-scheduled",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.18",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "^15.5.29",
    "pg": "^8.23.1",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "overrides": {
    "postcss": "8.5.33"
  },
  "engines": {
    "node": ">=20"
  }
}
